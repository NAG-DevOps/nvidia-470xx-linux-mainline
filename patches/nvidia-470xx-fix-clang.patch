-            void conftest_bitmap_clear() {
+            void conftest_bitmap_clear(void) {
                 bitmap_clear();
             }"
 
@@ -2434,7 +2434,7 @@ compile_test() {
             CODE="
             #include <linux/types.h>
             #include <linux/pci.h>
-            void conftest_pci_stop_and_remove_bus_device() {
+            void conftest_pci_stop_and_remove_bus_device(void) {
                 pci_stop_and_remove_bus_device();
             }"
 
@@ -2451,7 +2451,7 @@ compile_test() {
             CODE="
             #include <linux/types.h>
             #include <linux/pci.h>
-            void conftest_pci_remove_bus_device() {
+            void conftest_pci_remove_bus_device(void) {
                 pci_remove_bus_device();
             }"
 
@@ -3787,7 +3787,7 @@ compile_test() {
                 echo "#define NV_LINUX_OF_H_USABLE" | append_conftest "generic"
                 CODE="
                 #include <linux/of.h>
-                void conftest_of_find_matching_node() {
+                void conftest_of_find_matching_node(void) {
                     of_find_matching_node();
                 }"
 
@@ -5231,8 +5231,18 @@ case "$5" in
         kernel_cc_major=`echo ${kernel_cc_version} | cut -d '.' -f 1`
         kernel_cc_minor=`echo ${kernel_cc_version} | cut -d '.' -f 2`
 
+        # For GCC, __GNUC__ / __GNUC_MINOR__ matches the compiler version.
+        # For Clang, it doesn't, so we need to check against its macros directly.
+        if echo "${kernel_cc_string}" | grep -q clang; then
+            cc_major_macro=__clang_major__
+            cc_minor_macro=__clang_minor__
+        else
+            cc_major_macro=__GNUC__
+            cc_minor_macro=__GNUC_MINOR__
+        fi
+
         echo "
-        #if (__GNUC__ != ${kernel_cc_major}) || (__GNUC_MINOR__ != ${kernel_cc_minor})
+        #if (${cc_major_macro} != ${kernel_cc_major}) || (${cc_minor_macro} != ${kernel_cc_minor})
         #error \"cc version mismatch\"
         #endif
         " > conftest$$.c
