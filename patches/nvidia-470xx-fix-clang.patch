 conftest.sh                          | 50 +++++++++++++++++-----------
 nvidia-uvm/uvm_common.c              |  2 +-
 nvidia-uvm/uvm_gpu_access_counters.c |  4 +--
 nvidia-uvm/uvm_lock.c                |  2 +-
 nvidia-uvm/uvm_migrate.c             |  4 +--
 nvidia-uvm/uvm_migrate_pageable.c    |  4 +--
 nvidia-uvm/uvm_perf_heuristics.c     |  4 +--
